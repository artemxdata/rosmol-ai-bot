APP_ENV=local
LOG_LEVEL=INFO
INSTALL_ML=false

CLOUD_RU_API_KEY=replace-with-cloud-ru-api-key
CLOUD_RU_CHAT_COMPLETIONS_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
CLOUD_RU_MODEL=ai-sage/GigaChat3-10B-A1.8B
CLOUD_RU_MODEL_SIMPLE=ai-sage/GigaChat3-10B-A1.8B
CLOUD_RU_MODEL_COMPLEX=GigaChat/GigaChat-2-Max
CLOUD_RU_MODEL_ANALYZER=
CLOUD_RU_MODEL_JUDGE=

POSTGRES_USER=rosmol
POSTGRES_PASSWORD=rosmol
POSTGRES_DB=rosmol_ai_bot
POSTGRES_DSN=postgresql://rosmol:rosmol@postgres:5432/rosmol_ai_bot

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

RERANKER_THRESHOLD_LOW=0.4
RERANKER_THRESHOLD_HIGH=0.7
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24
PROMPT_VERSION=v1.0

SESSION_TTL_SECONDS=1800
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=300
MEMORY_TTL_DAYS=30

