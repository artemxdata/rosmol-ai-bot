APP_ENV=local
LOG_LEVEL=INFO
INSTALL_ML=false
ML_UNLOAD_AFTER_USE=false
# ML_UNLOAD_EMBEDDER_AFTER_USE=true
# ML_UNLOAD_RERANKER_AFTER_USE=false
ML_PREWARM_ON_STARTUP=false
ML_PREWARM_TIMEOUT_SECONDS=120
APP_HOST_PORT=8000
APP_ML_HOST_PORT=8001
NGINX_BIND=127.0.0.1
NGINX_HOST_PORT=8080
NGINX_TLS_BIND=127.0.0.1
NGINX_TLS_HOST_PORT=8443
API_AUTH_TOKEN=
WEBHOOK_AUTH_TOKEN=
ADMIN_AUTH_TOKEN=
USER_HASH_SECRET=
ADMIN_QUALITY_REPORT_PATH=reports/presentation_quality/presentation_quality_report.json
HDE_TRIGGER_PREFIX=
HDE_BASE_URL=https://your-helpdeskeddy-domain
HDE_API_EMAIL=
HDE_API_KEY=
HDE_BOT_USER_ID=
HDE_REQUEST_TIMEOUT_SECONDS=20
HDE_RATE_LIMIT_RPM=250
HDE_RATE_LIMIT_REMAINING_RESERVE=30
HDE_RATE_LIMIT_BAN_SECONDS=1200
KB_SEED_PATH=data/knowledge_base_seed.json
YONOTE_API_TOKEN=
YONOTE_BASE_URL=https://rossmol.yonote.ru
YONOTE_MAX_RETRIES=2
YONOTE_MIN_REQUEST_INTERVAL_SECONDS=0.15
YONOTE_SYNC_ENABLED=false
YONOTE_SYNC_MODE=manual
YONOTE_COLLECTION_NAMES=Росмолодёжь: общее, структура, направления;Росмолодёжь: мероприятия
YONOTE_REQUEST_TIMEOUT_SECONDS=30

CLOUD_RU_API_KEY=replace-with-cloud-ru-api-key
CLOUD_RU_CHAT_COMPLETIONS_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
CLOUD_RU_MODEL=ai-sage/GigaChat3-10B-A1.8B
CLOUD_RU_MODEL_SIMPLE=ai-sage/GigaChat3-10B-A1.8B
CLOUD_RU_MODEL_COMPLEX=GigaChat/GigaChat-2-Max
CLOUD_RU_MODEL_ANALYZER=
CLOUD_RU_MODEL_JUDGE=
# Set both simple-model tariffs to the current provider values before any live eval.
# Zero is fail-closed for live eval cost accounting; do not guess these values.
CLOUD_RU_MODEL_SIMPLE_INPUT_PRICE_RUB_PER_MILLION=0
CLOUD_RU_MODEL_SIMPLE_OUTPUT_PRICE_RUB_PER_MILLION=0
CLOUD_RU_MODEL_COMPLEX_INPUT_PRICE_RUB_PER_MILLION=569.34
CLOUD_RU_MODEL_COMPLEX_OUTPUT_PRICE_RUB_PER_MILLION=569.34
# Persistent, private, append-only reservations for paid live evals.
EVAL_COST_LEDGER_DIR=data/private/eval-cost-ledger-v1
CLOUD_RU_REQUEST_TIMEOUT_SECONDS=12
CLOUD_RU_MAX_RETRIES=2

POSTGRES_USER=rosmol
POSTGRES_PASSWORD=rosmol
POSTGRES_DB=rosmol_ai_bot
POSTGRES_DSN=postgresql://rosmol:rosmol@postgres:5432/rosmol_ai_bot

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_KNOWLEDGE_COLLECTION=knowledge_base

RERANKER_THRESHOLD_LOW=0.4
RERANKER_THRESHOLD_HIGH=0.7
RETRIEVAL_STRICT_FORUM_STOP_MIN_CHUNKS=3
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24
PROMPT_VERSION=v1.0

SESSION_TTL_SECONDS=1800
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=300
MEMORY_TTL_DAYS=30
REQUEST_TIMEOUT_SECONDS=45
