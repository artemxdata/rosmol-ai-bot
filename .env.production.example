# Copy through the approved generator only. Never commit .env.production.
APP_ENV=production
RELEASE_GIT_SHA=replace-with-trusted-40-character-lowercase-git-sha
POSTGRES_USER=rosmol
POSTGRES_PASSWORD=replace-with-new-random-postgres-password
POSTGRES_DB=rosmol_ai_bot
POSTGRES_DSN=postgresql://rosmol:replace-with-new-random-postgres-password@postgres:5432/rosmol_ai_bot
REDIS_PASSWORD=replace-with-new-random-redis-password
REDIS_URL=redis://:replace-with-new-random-redis-password@redis:6379/0
QDRANT_API_KEY=replace-with-new-random-qdrant-api-key

API_AUTH_TOKEN=replace-with-independent-random-api-token-at-least-32-chars
WEBHOOK_AUTH_TOKEN=replace-with-independent-random-webhook-token-at-least-32-chars
ADMIN_AUTH_TOKEN=replace-with-independent-random-admin-token-at-least-32-chars
ADMIN_READ_ONLY=true
USER_HASH_SECRET=replace-with-independent-random-hmac-secret-at-least-32-chars

HDE_TRIGGER_PREFIX=replace-with-new-independent-trigger-prefix
HDE_TRANSPORT_EVENT_KEY_SECRET=replace-with-independent-random-event-hmac-secret-at-least-32-chars
HDE_TRANSPORT_ENCRYPTION_KEY=replace-with-independent-random-encryption-key-at-least-32-chars
HDE_TRANSPORT_LEASE_TIMEOUT_SECONDS=420
HDE_TRANSPORT_RECOVERY_INTERVAL_SECONDS=30
HDE_TRANSPORT_SHUTDOWN_TIMEOUT_SECONDS=420
HDE_TRANSPORT_QUEUE_STALE_AFTER_SECONDS=900
HDE_BASE_URL=https://replace-with-approved-hde-host
HDE_API_EMAIL=replace-with-hde-api-user-email
HDE_API_KEY=replace-with-approved-hde-api-key
HDE_BOT_USER_ID=

CLOUD_RU_API_KEY=replace-with-new-cloud-ru-api-key
CLOUD_RU_CHAT_COMPLETIONS_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
CLOUD_RU_MODEL_SIMPLE=ai-sage/GigaChat3-10B-A1.8B
CLOUD_RU_MODEL_COMPLEX=GigaChat/GigaChat-2-Max

YONOTE_SYNC_ENABLED=false
YONOTE_SYNC_MODE=manual
YONOTE_API_TOKEN=
YONOTE_BASE_URL=https://rossmol.yonote.ru
YONOTE_COLLECTION_NAMES=Росмолодёжь: общее, структура, направления;Росмолодёжь: мероприятия
YONOTE_REQUEST_TIMEOUT_SECONDS=30
YONOTE_MAX_RETRIES=2
YONOTE_MIN_REQUEST_INTERVAL_SECONDS=0.15

QDRANT_URL=http://qdrant:6333
QDRANT_KNOWLEDGE_COLLECTION=knowledge_base

NGINX_BIND=0.0.0.0
NGINX_HOST_PORT=80
NGINX_TLS_BIND=0.0.0.0
NGINX_TLS_HOST_PORT=443
ADMIN_PUBLIC_HOST=bot.example.test
CERTBOT_EMAIL=operations@example.test

ML_PREWARM_TIMEOUT_SECONDS=300
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2G
APP_ML_CPU_LIMIT=6.0
APP_ML_MEMORY_LIMIT=12G
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=1G
QDRANT_CPU_LIMIT=3.0
QDRANT_MEMORY_LIMIT=4G
NGINX_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256M
EGRESS_PROXY_CPU_LIMIT=0.5
EGRESS_PROXY_MEMORY_LIMIT=256M
